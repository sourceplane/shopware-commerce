# Local development. Every value is optional: with no Shopware store the
# storefront builds and serves an empty catalogue that says how to connect
# one. The store's name is apps/web/app/site.ts.
#
#   Next's dev server (`pnpm dev`) and `pnpm build`   → copy to .env.local
#
# It is git-ignored. On the deployed Workers these are this repository's Orun
# secrets, one value per environment (the README, "Connecting Shopware"):
# SHOPWARE_STORE_DOMAIN and SHOPWARE_ACCESS_TOKEN are read by the build, and
# each deploy puts SHOPWARE_REVALIDATION_SECRET on the Worker as a secret —
# for the Worker preview (`pnpm preview`) put that one in .dev.vars instead.
COMPANY_NAME=""
# The shop's domain (shop.example.com; https:// unless you write http://).
SHOPWARE_STORE_DOMAIN=""
# The sales channel's Store API access key.
SHOPWARE_ACCESS_TOKEN=""
SHOPWARE_API_TYPE="store-api"
SHOPWARE_USE_SEO_URLS="true"
SHOPWARE_REVALIDATION_SECRET=""
